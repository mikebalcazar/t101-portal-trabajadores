# Copia este archivo como  llaves.env  y pega tus valores reales.
# llaves.env NO se sube a ningún lado: vive solo en esta carpeta, en tu computadora.

# Token de Cloudflare (dash.cloudflare.com -> My Profile -> API Tokens)
# Permisos: Workers Scripts:Edit, Workers R2 Storage:Edit, D1:Edit,
#           Account Settings:Read, User Details:Read
CLOUDFLARE_API_TOKEN=

# Llave de Resend para los correos (resend.com -> API Keys). Empieza con re_
RESEND_API_KEY=

# Clave que usará administración para entrar a /admin
CLAVE_ADMIN=
